{
    "name": "cascading-slot-game-service",
    "version": "1.0.0",
    "description": "",
    "main": "./src/app.js",
    "scripts": {
        "test": "jest --testPathPattern=tests/unit-tests",
        "test-coverage": "jest --collect-coverage --testPathPattern=tests/unit-tests",
        "dev": "nodemon --es-module-specifier-resolution=node --watch ./src ./src/app.js",
        "debug": "nodemon --es-module-specifier-resolution=node --watch ./ --inspect ./src/app.js",
        "prod": "node --max-old-space-size=8192 --es-module-specifier-resolution=node ./src/app.js",
        "reg": "npm set registry http://npm.lumigame.com",
        "integration-test": "jest --config ./jest.integration-test.config.cjs --testPathPattern=tests/integration-tests/ --ci --reporters=default --reporters=jest-junit --forceExit --runInBand"
    },
    "jestSonar": {
        "reportPath": "reports",
        "reportFile": "test-reporter.xml",
        "indent": 4
    },
    "author": "pentagon",
    "license": "ISC",
    "type": "module",
    "dependencies": {
        "lodash.clonedeep": "^4.5.0",
        "sc-cascading-slot-base": "2.0.0-beta.15",
        "sc-trial-mode": "1.0.1"
    },
    "devDependencies": {
        "@babel/preset-env": "7.24.4",
        "@commitlint/cli": "9.1.2",
        "@commitlint/config-conventional": "9.1.2",
        "babel-jest": "26.6.3",
        "babel-plugin-rewire": "1.2.0",
        "husky": "4.3.8",
        "install": "0.13.0",
        "jest": "^29.0.0",
        "jest-auto-fixture": "^1.0.6",
        "jest-extended": "^4.0.2",
        "jest-micro-auto-stub": "1.0.9",
        "jest-sonar-reporter": "2.0.0",
        "jest-when": "3.6.0",
        "jest-html-reporters": "^3.1.1",
        "jest-junit": "13.2.0",
        "nodemon": "2.0.22",
        "sc-game-service-integration-utils": "2.3.0"
    },
    "husky": {
        "hooks": {
            "commit-msg": "commitlint -E HUSKY_GIT_PARAMS"
        }
    }
}
